APP_NAME=ResearchPilot Paper Discovery
APP_ENV=local
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://researchpilot:researchpilot@postgres:5432/researchpilot

# --- qDrant DB ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=research_paper_chunks

# --- Chat LLM: groups 001-015 (VM07) ---
GROUP_API_KEY=YOUR_GROUP_API_KEY
LLM_API_BASE=https://103.42.50.41:1031/v1
CA_CERT_PATH=certs/vm07-ca.crt
LLM_MODEL=Qwen/Qwen3-8B

# --- Shared embedding API (VM02) ---
EMBED_API_KEY=YOUR_EMBEDDINGS_KEY
EMBED_API_BASE=https://103.42.50.41:1035/v1
EMBED_CA_CERT_PATH=certs/vm02-ca.crt
EMBED_MODEL=bge-small-en-v1.5

EMBEDDING_DIM=384
CHUNK_SIZE_WORDS=450
CHUNK_OVERLAP_WORDS=80
MAX_UPLOAD_MB=30
UPLOAD_DIR=/app/data/uploads